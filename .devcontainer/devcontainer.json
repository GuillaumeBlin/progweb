{  
  "name": "Node JS Development with VNC Desktop",
  "build": {
    "dockerfile": "dockerfile"
  },
  "postCreateCommand": "",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
			"installZsh": "true",
			"username": "vscode",
			"upgradePackages": "true"
		},
		"ghcr.io/devcontainers/features/node:2": {
			"version": "none"
		},
		"ghcr.io/devcontainers/features/git:1": {
            "version": "latest",
            "ppa": "false"
        },
	  
    "ghcr.io/devcontainers/features/desktop-lite:1": {
    }
  },
  "updateContentCommand": "",
  "customizations": {
    "vscode": {
      "extensions": []
    }
  },
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "desktop"
    }
  },
  "remoteUser": "vscode"
}
