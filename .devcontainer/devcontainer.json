{  
  "name": "Node JS Development with VNC Desktop",
  "image": "mcr.microsoft.com/devcontainers/javascript-node",
  "postCreateCommand": "&& sudo apt-get install -y xvfb x11vnc",
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "containerUser": "node"
    }
  },
  "updateContentCommand": "",
  "customizations": {
    "vscode": {
      "extensions": []
    }
  },
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "desktop"
    }
  },
  "remoteUser": "node"
}
